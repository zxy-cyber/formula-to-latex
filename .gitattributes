# 统一换行符，避免不同系统之间把整个文件都标记成改动
* text=auto

# Windows 脚本用 CRLF（PowerShell 更友好）
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 这两个脚本在 macOS / Linux 上要有可执行位，且必须是 LF
gradlew text eol=lf

# 二进制文件，禁止任何换行/编码转换
*.jar      binary
*.jks      binary
*.keystore binary
*.apk      binary
*.png      binary
*.webp     binary
