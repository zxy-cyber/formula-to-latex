<?xml version="1.0" encoding="utf-8"?>
<!-- 编辑操作按键（上一步 / 下一步 / 删除 / 清空 / 撤销 / 重做） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_edit_pressed" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/key_edit_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_edit_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/key_edit_stroke" />
        </shape>
    </item>
</selector>
